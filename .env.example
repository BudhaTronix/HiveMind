HIVEMIND_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Disable long reasoning traces for faster structured workflow calls.
OLLAMA_THINK=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional provider-specific model override for each role.
HIVEMIND_MODEL_CEO=
HIVEMIND_MODEL_MANAGER=
HIVEMIND_MODEL_WORKER=
HIVEMIND_MODEL_VERIFIER=
HIVEMIND_MODEL_QA=
HIVEMIND_MODEL_MEMORY=

HIVEMIND_DB_PATH=./data/hivemind.db
HIVEMIND_RUNS_DIR=./runs
HIVEMIND_MEMORY_BACKEND=simple
HIVEMIND_MEM0_EMBED_MODEL=nomic-embed-text
HIVEMIND_ENABLE_WEB=true

HIVEMIND_MAX_MANAGERS=3
HIVEMIND_MAX_WORKERS_PER_MANAGER=3
HIVEMIND_MAX_TOTAL_AGENTS=15
HIVEMIND_MAX_CONCURRENT_LLM_CALLS=3
HIVEMIND_MAX_CONCURRENT_WEB_REQUESTS=4
HIVEMIND_MAX_RESEARCH_ROUNDS=2
HIVEMIND_MAX_SEARCH_QUERIES_PER_WORKER=2
HIVEMIND_MAX_RETRIES=2
HIVEMIND_LLM_CALL_TIMEOUT_SECONDS=300
HIVEMIND_MAX_RUNTIME_SECONDS=900

HIVEMIND_LOG_LEVEL=INFO
